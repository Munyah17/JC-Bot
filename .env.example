# Server
PORT=3000

# WhatsApp Cloud API credentials (from Meta for Developers)
WHATSAPP_TOKEN=EAAG...your-permanent-or-temp-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
VERIFY_TOKEN=my-secret-verify-token

# Optional: WhatsApp Business Account ID (for logging/debug)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Optional: where to send human-handoff alerts (an agent's WhatsApp number, e.g. 15551234567)
AGENT_NOTIFICATION_NUMBER=

# Set to "true" to run the webhook without Meta credentials (replies are logged to console)
DRY_RUN=false

# Supabase persistence (optional — bot runs without it, falls back to in-memory + JSONL)
# Project URL: Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://owuzgtifqspeapsnpare.supabase.co
# Service role key: Dashboard → Project Settings → API → service_role (SECRET — server only)
SUPABASE_SERVICE_KEY=paste-service-role-key-here
